    "actions = ['Thank_you', 'Hello', 'Good', 'Maybe', 'Goodbye']\n",
    "\n",
    "i = 0\n",
    "is_done = False\n",
    "while i < len(actions):\n",
    "    print(actions[i])\n",
    "    if i == 2 and not is_done: \n",
    "        is_done = True\n",
    "        i -= 1\n",
    "    else:\n",
    "        i += 1"
   ]
